# Keep bazel_compatibility aligned with sonic-buildimage and sonic-swss-common.
module(
    name = "sonic-swss",
    version = "0.0.0",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
    repo_name = "sonic_swss",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "libnl3", version = "3.7.0-sonic.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf-legacy", version = "3.21.12-sonic.1", repo_name = "protobuf_legacy")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_distroless", version = "0.9.4-sonic.1")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_rust_bindgen", version = "0.74.0")
bazel_dep(name = "sai", version = "1.18.0-sonic.1")
bazel_dep(name = "tar.bzl", version = "0.10.5")

bazel_dep(name = "toolchains_llvm", version = "1.5.0", dev_dependency = True)

bazel_dep(
    name = "sonic-build-infra",
    version = "0.0.14-f9876051703da05af745ffc781706e29fed7dd4b",
    repo_name = "sonic_build_infra",
)
bazel_dep(
    name = "sonic-dash-api",
    version = "0.0.4-2a6e390b96a4fc17c191fa0da4b7ed1f40aed069",
    repo_name = "sonic_dash_api",
)
bazel_dep(
    name = "sonic-sairedis",
    version = "0.0.0-e9402b77ba43aee6323665921598ef67e66293f9",
    repo_name = "sonic_sairedis",
)
bazel_dep(
    name = "sonic-swss-common",
    version = "0.0.1-5882fa4bd954b0d97d7acc1ef270225d981733a4",
    repo_name = "sonic_swss_common",
)

# Historical dotted versions requested by dependencies sort above this release.
single_version_override(
    module_name = "libnl3",
    version = "3.7.0-sonic.2",
)

# Stock and historical dotted releases sort above the native protobuf fix.
single_version_override(
    module_name = "rules_distroless",
    version = "0.9.4-sonic.1",
)

# RE2's BCR metadata repair marks its legacy local C++ extension as development-only.
single_version_override(
    module_name = "re2",
    version = "2024-07-02.bcr.1",
)

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

# sonic-build-infra owns the common Debian dependency set.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "swss_debian",
    packages = [
        "libjansson-dev",
        "libjemalloc-dev",
        "libteam-dev",
        "libyaml-cpp-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "swss_debian", "trixie")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Bindgen toolchain selection belongs to the consuming root. This LLVM
# selection is for standalone builds only.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(llvm_version = "17.0.6")
use_repo(llvm, "llvm_toolchain_llvm")

register_toolchains(
    "//tools/bazel/rust/dev:bindgen_toolchain",
    dev_dependency = True,
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "swss_crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:Cargo.Bazel.lock",
    manifests = ["//:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.annotation(
    crate = "swss-common",
    gen_build_script = "off",
    override_target_lib = "@sonic_swss_common//crates/swss-common:swss_common",
)

# Common's public types implement Serde traits. All consumers must use the same
# Serde targets so those implementations work across the module boundary.
crate.annotation(
    crate = "serde",
    override_target_lib = "@sonic_swss_common//crates/swss-common:serde",
)
crate.annotation(
    crate = "serde_core",
    override_target_lib = "@sonic_swss_common//crates/swss-common:serde_core",
)
use_repo(crate, crates = "swss_crates")
