# Keep bazel_compatibility aligned with sonic-buildimage and sonic-swss-common.
module(
    name = "sonic-swss",
    version = "0.0.0",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
    repo_name = "sonic_swss",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "googletest", version = "1.11.0", repo_name = "com_google_googletest")
bazel_dep(name = "libnl3", version = "3.7.0-sonic.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf-legacy", version = "3.21.12-sonic.1", repo_name = "protobuf_legacy")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_distroless", version = "0.9.4-sonic.1")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_rust_bindgen", version = "0.74.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "sai", version = "1.18.0-sonic.1")
bazel_dep(name = "tar.bzl", version = "0.10.5")
bazel_dep(name = "toolchains_llvm", version = "1.5.0")
bazel_dep(
    name = "sonic-build-infra",
    version = "0.0.14-ac6583668dbb92421b48009119f3472ee3e40b27",
    repo_name = "sonic_build_infra",
)
bazel_dep(
    name = "sonic-dash-api",
    version = "0.0.4-c28c2c28b2db56163d5b9c48497c0eee2379f7fd",
    repo_name = "sonic_dash_api",
)
bazel_dep(
    name = "sonic-sairedis",
    version = "0.0.0-df4319696743f4804053ab68c5af1a2b8254dcb4",
    repo_name = "sonic_sairedis",
)
bazel_dep(
    name = "sonic-swss-common",
    version = "0.0.0-093a849f01722afb4730e685b3eb4f22a9bc9191",
    repo_name = "sonic_swss_common",
)

# Historical dotted versions requested by dependencies sort above this release.
single_version_override(
    module_name = "libnl3",
    version = "3.7.0-sonic.2",
)

# Stock and historical dotted releases sort above the native protobuf fix.
single_version_override(
    module_name = "rules_distroless",
    version = "0.9.4-sonic.1",
)

# RE2's BCR metadata repair marks its legacy local C++ extension as development-only.
single_version_override(
    module_name = "re2",
    version = "2024-07-02.bcr.1",
)

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

# sonic-build-infra owns the common Debian dependency set.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "swss_debian",
    packages = [
        "libjansson-dev",
        "libjemalloc-dev",
        "libteam-dev",
        "libyaml-cpp-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "swss_debian", "trixie")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(llvm_version = "17.0.6")
use_repo(llvm, "llvm_toolchain_llvm")

register_toolchains("//tools/bazel:bindgen_toolchain")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.annotation(
    compile_data = ["@sonic_swss//tools/bazel/rust:swss_common_bindings_dir"],
    crate = "swss-common",
    gen_build_script = "off",
    label_injections = {
        "//tools/bazel/rust:swss_common_bindings_dir": "@sonic_swss",
        "@sonic_swss_common//:libswsscommon_shared": "@sonic_swss_common",
    },
    rustc_env = {
        "OUT_DIR": "$(execpath @sonic_swss//tools/bazel/rust:swss_common_bindings_dir)",
    },
    version = "0.1.0",
    deps = ["@sonic_swss_common//:libswsscommon_shared"],
)
use_repo(crate, "crates")
