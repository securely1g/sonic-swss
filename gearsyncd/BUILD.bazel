load("//tools/bazel:cc.bzl", "swss_cc_binary", "swss_headers")
load("//tools/bazel:deps.bzl", "SWSS_DEPS")

package(default_visibility = ["//visibility:public"])

exports_files(glob([
    "*.cpp",
    "*.h",
]))

swss_headers(
    name = "headers",
    hdrs = glob(["*.h"]),
    includes = ["."],
)

# Preserve the native local header search order, including repeated roots.
GEARSYNCD_INCLUDE_DIRECTORIES = [
    "gearsyncd",
    ".",
    "lib",
    ".",
    "warmrestart",
    "cfgmgr",
]

swss_cc_binary(
    name = "gearsyncd",
    srcs = [
        # do not sort
        "//lib:gearboxutils.cpp",
        "gearsyncd.cpp",
        "gearparserbase.cpp",
        "gearboxparser.cpp",
        "phyparser.cpp",
    ],
    gcov_preload = "shared",
    local_include_directories = GEARSYNCD_INCLUDE_DIRECTORIES,
    deps = SWSS_DEPS + [
        ":production_headers",
        "//cfgmgr:production_headers",
        "//lib:production_headers",
    ],
)
