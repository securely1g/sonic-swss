load("//bazel:production_sources.bzl", "SWSS_PROGRAMS")
load("//tools/bazel:cc.bzl", "swss_cc_binary", "swss_headers")
load("//tools/bazel:deps.bzl", "ORCHAGENT_DEPS", "SWSS_DEPS")

package(default_visibility = ["//visibility:public"])

exports_files(glob(
    [
        "**/*.cpp",
        "**/*.h",
        "*.lua",
    ],
    exclude = ["p4orch/tests/**"],
))

swss_headers(
    name = "headers",
    hdrs = glob(
        ["**/*.h"],
        exclude = ["p4orch/tests/**"],
    ),
    includes = [
        ".",
        "buffer",
        "cbf",
        "dash",
        "debug_counter",
        "flex_counter",
        "high_frequency_telemetry",
        "p4orch",
        "pbh",
        "port",
        "switch",
    ],
)

filegroup(
    name = "lua_files",
    srcs = [
        "drop_monitor.lua",
        "eliminate_events.lua",
        "lagids.lua",
        "nvda_port_trim_drop.lua",
        "pfc_detect_barefoot.lua",
        "pfc_detect_broadcom.lua",
        "pfc_detect_cisco-8000.lua",
        "pfc_detect_clounix.lua",
        "pfc_detect_marvell-prestera.lua",
        "pfc_detect_marvell-teralynx.lua",
        "pfc_detect_mellanox.lua",
        "pfc_detect_nephos.lua",
        "pfc_detect_vs.lua",
        "pfc_restore.lua",
        "pfc_restore_cisco-8000.lua",
        "port_flr.lua",
        "port_rates.lua",
        "rif_rates.lua",
        "trap_rates.lua",
        "tunnel_rates.lua",
        "watermark_bufferpool.lua",
        "watermark_pg.lua",
        "watermark_queue.lua",
    ],
)

ORCHAGENT_HEADERS = [
    ":production_headers",
    "//cfgmgr:production_headers",
    "//lib:production_headers",
    "//warmrestart:production_headers",
]

swss_cc_binary(
    name = "orchagent",
    srcs = SWSS_PROGRAMS["orchagent"]["sources"],
    ndebug = True,
    deps = ORCHAGENT_DEPS + ORCHAGENT_HEADERS,
)

swss_cc_binary(
    name = "routeresync",
    srcs = SWSS_PROGRAMS["routeresync"]["sources"],
    ndebug = True,
    deps = SWSS_DEPS + ORCHAGENT_HEADERS,
)

swss_cc_binary(
    name = "orchagent_restart_check",
    srcs = SWSS_PROGRAMS["orchagent_restart_check"]["sources"],
    ndebug = True,
    deps = SWSS_DEPS + ORCHAGENT_HEADERS,
)
