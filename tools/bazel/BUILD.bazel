load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_cc//cc:defs.bzl", "cc_import")
load("@rules_rust_bindgen//:defs.bzl", "rust_bindgen_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files(["run_cc_test.sh"])

bool_flag(
    name = "asan",
    build_setting_default = False,
)

config_setting(
    name = "asan_enabled",
    flag_values = {":asan": "True"},
)

bool_flag(
    name = "gcov",
    build_setting_default = False,
)

config_setting(
    name = "gcov_enabled",
    flag_values = {":gcov": "True"},
)

config_setting(
    name = "release_link",
    flag_values = {
        ":asan": "False",
        ":gcov": "False",
    },
    values = {"compilation_mode": "opt"},
)

native_binary(
    name = "clang",
    src = "@llvm_toolchain_llvm//:bin/clang",
)

cc_import(
    name = "libclang",
    shared_library = "@llvm_toolchain_llvm//:libclang",
)

rust_bindgen_toolchain(
    name = "bindgen_toolchain_impl",
    # rules_rust_bindgen 0.74.0 supplies bindgen 0.71.1 for this prototype.
    # Cargo.lock retains swss-common's bindgen 0.70.1 build dependency.
    bindgen = "@rules_rust_bindgen//3rdparty:bindgen",
    clang = ":clang",
    libclang = ":libclang",
)

toolchain(
    name = "bindgen_toolchain",
    toolchain = ":bindgen_toolchain_impl",
    toolchain_type = "@rules_rust_bindgen//:toolchain_type",
)
