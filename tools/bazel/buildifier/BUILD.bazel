load("@buildifier_prebuilt//:rules.bzl", "buildifier")

buildifier(
    name = "buildifier",
    exclude_patterns = ["./.git/*", "./bazel-*/*", "./target/*"],
    lint_mode = "fix",
    mode = "fix",
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = ["./.git/*", "./bazel-*/*", "./target/*"],
    lint_mode = "warn",
    mode = "diff",
)
