load("@sonic_build_infra//tar:sonic_deploy_tar.bzl", "sonic_deploy_tar")

package(default_visibility = ["//visibility:public"])

# Runtime programs are declared here and checked against Automake in CI.
CPP_BINARIES = [
    "//cfgmgr:vlanmgrd",
    "//cfgmgr:teammgrd",
    "//cfgmgr:portmgrd",
    "//cfgmgr:intfmgrd",
    "//cfgmgr:buffermgrd",
    "//cfgmgr:vrfmgrd",
    "//cfgmgr:nbrmgrd",
    "//cfgmgr:vxlanmgrd",
    "//cfgmgr:sflowmgrd",
    "//cfgmgr:natmgrd",
    "//cfgmgr:coppmgrd",
    "//cfgmgr:tunnelmgrd",
    "//cfgmgr:macsecmgrd",
    "//cfgmgr:fabricmgrd",
    "//cfgmgr:stpmgrd",
    "//fdbsyncd:fdbsyncd",
    "//fpmsyncd:fpmsyncd",
    "//gearsyncd:gearsyncd",
    "//mclagsyncd:mclagsyncd",
    "//natsyncd:natsyncd",
    "//neighsyncd:neighsyncd",
    "//orchagent:orchagent",
    "//orchagent:orchagent_restart_check",
    "//orchagent:routeresync",
    "//portsyncd:portsyncd",
    "//swssconfig:swssconfig",
    "//swssconfig:swssplayer",
    "//teamsyncd:teamsyncd",
    "//tlm_teamd:tlm_teamd",
]

RUST_BINARIES = ["//crates/countersyncd:countersyncd"]

filegroup(
    name = "cpp_binaries",
    srcs = CPP_BINARIES,
)

# Additional payload installed by debian/swss.install.
DEBIAN_FILES = {
    "usr/bin/bgp_eoiu_marker.py": "//fpmsyncd:bgp_eoiu_marker.py",
    "usr/bin/restore_neighbors.py": "//neighsyncd:restore_neighbors.py",
    "etc/swss/config.d/netbouncer.json": "//swssconfig:sample/netbouncer.json",
}

LUA_FILES = [
    "//cfgmgr:buffer_check_headroom_mellanox.lua",
    "//cfgmgr:buffer_headroom_mellanox.lua",
    "//cfgmgr:buffer_pool_mellanox.lua",
    "//cfgmgr:buffer_check_headroom_vs.lua",
    "//cfgmgr:buffer_headroom_vs.lua",
    "//cfgmgr:buffer_pool_vs.lua",
    "//cfgmgr:buffer_check_headroom_barefoot.lua",
    "//cfgmgr:buffer_headroom_barefoot.lua",
    "//cfgmgr:buffer_pool_barefoot.lua",
    "//orchagent:nvda_port_trim_drop.lua",
    "//orchagent:eliminate_events.lua",
    "//orchagent:rif_rates.lua",
    "//orchagent:pfc_detect_marvell-teralynx.lua",
    "//orchagent:pfc_detect_mellanox.lua",
    "//orchagent:pfc_detect_broadcom.lua",
    "//orchagent:pfc_detect_marvell-prestera.lua",
    "//orchagent:pfc_detect_barefoot.lua",
    "//orchagent:pfc_detect_nephos.lua",
    "//orchagent:pfc_detect_cisco-8000.lua",
    "//orchagent:pfc_detect_vs.lua",
    "//orchagent:pfc_restore.lua",
    "//orchagent:pfc_restore_cisco-8000.lua",
    "//orchagent:pfc_detect_clounix.lua",
    "//orchagent:port_rates.lua",
    "//orchagent:port_flr.lua",
    "//orchagent:drop_monitor.lua",
    "//orchagent:watermark_queue.lua",
    "//orchagent:watermark_pg.lua",
    "//orchagent:watermark_bufferpool.lua",
    "//orchagent:lagids.lua",
    "//orchagent:tunnel_rates.lua",
    "//orchagent:trap_rates.lua",
]

# Automake installs these VS names with the Mellanox implementations.
LUA_INSTALL_ALIASES = {
    "//cfgmgr:buffer_check_headroom_vs.lua": "//cfgmgr:buffer_check_headroom_mellanox.lua",
    "//cfgmgr:buffer_headroom_vs.lua": "//cfgmgr:buffer_headroom_mellanox.lua",
    "//cfgmgr:buffer_pool_vs.lua": "//cfgmgr:buffer_pool_mellanox.lua",
}

AUTOMAKE_FILES = {
    "usr/share/swss/" + label.split(":")[-1]: LUA_INSTALL_ALIASES.get(label, label)
    for label in LUA_FILES
}

sonic_deploy_tar(
    name = "swss_pkg",
    srcs = sorted(depset(AUTOMAKE_FILES.values() + DEBIAN_FILES.values()).to_list()),
    binaries = {
        "usr/bin/{} type=file uid=0 gid=0 mode=0755 time=0".format(label.split(":")[-1]): label
        for label in CPP_BINARIES + RUST_BINARIES
    },
    force_debug_build = True,
    mtree = [
        ". type=dir uid=0 gid=0 mode=0755 time=0",
        "etc type=dir uid=0 gid=0 mode=0755 time=0",
        "etc/swss type=dir uid=0 gid=0 mode=0755 time=0",
        "etc/swss/config.d type=dir uid=0 gid=0 mode=0755 time=0",
        "usr type=dir uid=0 gid=0 mode=0755 time=0",
        "usr/bin type=dir uid=0 gid=0 mode=0755 time=0",
        "usr/share type=dir uid=0 gid=0 mode=0755 time=0",
        "usr/share/swss type=dir uid=0 gid=0 mode=0755 time=0",
    ] + [
        "{} type=file uid=0 gid=0 mode=0644 time=0 content=$(location {})".format(path, label)
        for path, label in AUTOMAKE_FILES.items()
    ] + [
        "{} type=file uid=0 gid=0 mode={} time=0 content=$(location {})".format(
            path,
            "0755" if path.startswith("usr/bin/") else "0644",
            label,
        )
        for path, label in DEBIAN_FILES.items()
    ],
)
