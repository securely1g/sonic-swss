load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@swss_crates//:defs.bzl", "all_crate_deps")

package(default_visibility = ["//visibility:public"])

# rules_rs 0.0.99 has no cargo_toml_env_vars helper for first-party targets.
# Keep these values aligned with Cargo.toml so Clap preserves the Cargo-built CLI.
CARGO_PACKAGE_ENV = {
    "CARGO_PKG_AUTHORS": "SONiC",
    "CARGO_PKG_DESCRIPTION": "",
    "CARGO_PKG_HOMEPAGE": "",
    "CARGO_PKG_NAME": "countersyncd",
    "CARGO_PKG_REPOSITORY": "https://github.com/sonic-net/sonic-swss",
}

rust_library(
    name = "countersyncd_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "countersyncd",
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env = CARGO_PACKAGE_ENV,
    # Keep source lines in the linked ELF before sonic_deploy_tar splits it.
    rustc_flags = [
        "-Dwarnings",
        "-Cdebuginfo=2",
    ],
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "countersyncd",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/lib.rs"],
    ),
    crate_name = "countersyncd",
    crate_root = "src/main.rs",
    edition = "2021",
    # Preserve the interface-library paths supplied by rules_distroless.
    experimental_use_cc_common_link = 1,
    rustc_env = CARGO_PACKAGE_ENV,
    # Keep source lines in the linked ELF before sonic_deploy_tar splits it.
    rustc_flags = [
        "-Dwarnings",
        "-Cdebuginfo=2",
    ],
    version = "0.1.0",
    deps = [":countersyncd_lib"] + all_crate_deps(normal = True),
)

# Exercise Common's native string API and its Serde implementations through
# SWSS's resolved Rust dependencies. No Redis service is needed.
rust_test(
    name = "common_rust_test",
    srcs = ["common_rust_test.rs"],
    edition = "2021",
    experimental_use_cc_common_link = 1,
    deps = [
        "@swss_crates//:serde_json",
        "@swss_crates//:swss-common",
    ],
)
