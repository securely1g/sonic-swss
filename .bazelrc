common --check_direct_dependencies=off
common --noincompatible_disallow_empty_glob

# Keep the selected build-infra, libnl3, and Distroless inputs, then resolve
# the dependency-owned DASH, Common, SAI, and sairedis modules.
common --registry=https://raw.githubusercontent.com/securely1g/sonic-bazel-registry/2f4012b01f7a73f24b12de64a0a9ae86a06b0e89
common --registry=https://raw.githubusercontent.com/securely1g/sonic-bazel-registry/97dea0f4d4254de4fe17c56a6ceaf17b001cc4ce
common --registry=https://raw.githubusercontent.com/securely1g/sonic-bazel-registry/c999f3c9ebf59c5e2d8feaae8d5010fc9204ef92
common --registry=https://raw.githubusercontent.com/securely1g/sonic-bazel-registry/473dda85dc87430fddfdf12ab55a05da21748069
common --registry=https://bcr.bazel.build/

# sonic-buildimage supplies checkout overrides when this repository is a submodule.
try-import %workspace%/../../tools/bazel/submodule-config.bazelrc

# These toolchains execute on the same CPU they target.
common --platforms=@sonic_build_infra//platforms:x86_64_trixie
common:aarch64 --platforms=@sonic_build_infra//platforms:aarch64_trixie

# Build Common's YANG C++ sources and generate its schema from declared inputs.
common --@sonic_swss_common//tools/bazel:yang_modules=True

# The managed GCC toolchain supplies optimization and baseline hardening.
build:release --compilation_mode=opt

build:asan --//tools/bazel:asan=True
build:gcov --//tools/bazel:gcov=True
build:debug --compilation_mode=dbg

# Keep local configuration outside source control.
try-import %workspace%/.bazelrc.user
