load("//tools/bazel:cc.bzl", "swss_cc_binary", "swss_headers")
load("//tools/bazel:deps.bzl", "CFGMGR_DEPS")

package(default_visibility = ["//visibility:public"])

exports_files(glob([
    "*.cpp",
    "*.h",
    "*.lua",
]))

swss_headers(
    name = "headers",
    hdrs = glob(["*.h"]),
    includes = ["."],
)

filegroup(
    name = "lua_files",
    srcs = [
        # do not sort
        "buffer_check_headroom_barefoot.lua",
        "buffer_check_headroom_mellanox.lua",
        "buffer_check_headroom_vs.lua",
        "buffer_headroom_barefoot.lua",
        "buffer_headroom_mellanox.lua",
        "buffer_headroom_vs.lua",
        "buffer_pool_barefoot.lua",
        "buffer_pool_mellanox.lua",
        "buffer_pool_vs.lua",
    ],
)

CFGMGR_HEADERS = [
    ":production_headers",
    "//lib:production_headers",
    "//orchagent:production_headers",
    "//warmrestart:production_headers",
]

# Preserve the native local header search order, including repeated roots.
CFGMGR_INCLUDE_DIRECTORIES = [
    "cfgmgr",
    ".",
    "lib",
    ".",
    "orchagent",
    "warmrestart",
    "orchagent/flex_counter",
]

# Compile these shared sources with each daemon's own options.
CFGMGR_COMMON_SRCS = [
    "//orchagent:orch.cpp",
    "//orchagent:request_parser.cpp",
    "//orchagent:response_publisher.cpp",
    "//lib:recorder.cpp",
]

swss_cc_binary(
    name = "vlanmgrd",
    srcs = [
        # do not sort
        "vlanmgrd.cpp",
        "vlanmgr.cpp",
    ] + CFGMGR_COMMON_SRCS,
    local_include_directories = CFGMGR_INCLUDE_DIRECTORIES,
    deps = CFGMGR_DEPS + CFGMGR_HEADERS,
)

